source 'https://rubygems.org'

gem 'jekyll', '~> 4.4'
gem 'jemoji', '~> 0.13'
gem 'rouge', '~> 4.0' # jekyll ~> 4.4 exige rouge >= 3.0, < 5.0 — não subir para 5.x

# Required for `jekyll serve` on Ruby >= 3.0, since webrick left the standard library
# and Jekyll 4 stopped bundling it.
gem 'webrick', '~> 1.8'
